# ==========================================
# TELEGRAM CONTROL BOT
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ==========================================
# DATABASE (Railway PostgreSQL)
# ==========================================
DATABASE_URL=

# ==========================================
# SESSION ENCRYPTION
# ==========================================
# Generate ONCE with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER change this after users have connected their accounts — every stored
# session becomes unreadable and everyone has to /connect again.
SESSION_ENCRYPTION_KEY=

# ==========================================
# ADMINS
# ==========================================
# Comma-separated numeric Telegram IDs
ADMIN_TELEGRAM_IDS=

# ==========================================
# UPDATES CHANNEL (membership gate)
# ==========================================
# The control bot must be an ADMIN here for membership checks to work.
UPDATE_CHANNEL_USERNAME=@dealskoti_updates

# ==========================================
# RAZORPAY (INR — automatic activation)
# ==========================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_PATH=/webhooks/razorpay
# Public Railway URL without a trailing slash, e.g. https://your-app.up.railway.app
PUBLIC_BASE_URL=

# ==========================================
# USDT (manual — admin approves)
# ==========================================
# Leave the wallet empty to hide the USDT payment option entirely.
USDT_WALLET_ADDRESS=
USDT_NETWORK=TRC20

# ==========================================
# TELEGRAM STARS (manual — admin approves)
# ==========================================
# The @username users send Stars to. While this is empty the
# "Pay with Telegram Stars" button is hidden, so nobody can start a
# payment that has nowhere to go.
STARS_RECEIVER=

# ==========================================
# FILE STORAGE (Attach Custom File — Platinum)
# ==========================================
# Private channel where the bot is an ADMIN. Stored files live here; the
# local disk on Railway is ephemeral and is only used as a cache.
FILE_STORAGE_CHANNEL_ID=
MAX_FILE_SIZE_MB=2000

# ==========================================
# MISC
# ==========================================
SUPPORT_BOT_LINK=
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
MAX_CONCURRENT_FORWARD_TASKS=100
