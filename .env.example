# Telegram control bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Railway PostgreSQL
DATABASE_URL=

# Generate once and never change after sessions are connected
SESSION_ENCRYPTION_KEY=

# Razorpay test/live credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated numeric Telegram IDs
ADMIN_TELEGRAM_IDS=

# Public updates channel and its numeric Telegram ID
UPDATE_CHANNEL_USERNAME=@dealskoti_updates
UPDATE_CHANNEL_ID=-1001234567890

SUPPORT_BOT_LINK=
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
MAX_IMAGE_SIZE_MB=20
MAX_CONCURRENT_FORWARD_TASKS=10
RAZORPAY_WEBHOOK_PATH=/webhooks/razorpay
# Public Railway URL, for example https://your-service.up.railway.app
PUBLIC_BASE_URL=

# USDT manual payments (leave wallet empty to hide the USDT option)
USDT_WALLET_ADDRESS=
USDT_NETWORK=TRC20

# Platinum file-upload storage channel (private channel where bot is admin)
FILE_STORAGE_CHANNEL_ID=
# Max upload size in MB for /upload_file
MAX_FILE_SIZE_MB=2000
